{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["src/web/src/ui/*"],
      "@preview/*": ["src/web/src/preview/*"],
      "@app/*": ["src/web/src/app/*"]
    }
  },
  "include": ["src/web/src/**/*"]
}
