{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src/cli/**/*.ts", "src/server/**/*.ts", "src/core/**/*.ts", "src/web/src/app/retry-config.ts", "test/**/*.ts"]
}
